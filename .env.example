# API Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8100

# Authentication (JWT Settings)
JWT_SECRET_KEY=dev_jwt_secret_key_change_me_in_production
JWT_ALGORITHM=HS256

# Database Connection URLs (Local Docker Mappings)
DATABASE_URL=postgresql://medical_ai_user:medical_ai_password@localhost:5543/medical_ai_db
REDIS_URL=redis://localhost:7379/0
RABBITMQ_URL=amqp://medical_ai_mq_user:medical_ai_mq_password@localhost:5772/

# Backend Microservices Mock Ports
SERVICE_SCHEDULING_URL=http://localhost:8101
SERVICE_TELEHEALTH_URL=http://localhost:8102
SERVICE_SCRIBE_URL=http://localhost:8103
SERVICE_AGENT_URL=http://localhost:8104

# LiveKit Server Configuration
LIVEKIT_URL=ws://localhost:7980
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional managed voice providers. Leave blank to use typed booking help and
# the clearly labelled browser speech fallback; no simulated bookings are made.
VOICE_AGENT_ENABLED=false
VOICE_STT_PROVIDER=deepgram
VOICE_LLM_PROVIDER=openai
VOICE_TTS_PROVIDER=openai
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# SMTP Email Notifier Configuration (Fill with actual credentials to receive real emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@telehealth-medical-ai.com
